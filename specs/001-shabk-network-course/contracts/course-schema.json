{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CourseContentContract",
  "description": "JSON Schema validating course curriculum modules, lessons, quizzes, and troubleshooting labs in Shabk",
  "type": "object",
  "required": ["modules", "totalModules", "curriculumVersion"],
  "properties": {
    "curriculumVersion": { "type": "string" },
    "totalModules": { "type": "integer", "enum": [8] },
    "modules": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["id", "order", "titleFa", "titleEn", "descriptionFa", "estimatedMinutes", "lessons", "quiz"],
        "properties": {
          "id": { "type": "string", "pattern": "^module-[1-8]$" },
          "order": { "type": "integer", "minimum": 1, "maximum": 8 },
          "titleFa": { "type": "string" },
          "titleEn": { "type": "string" },
          "descriptionFa": { "type": "string" },
          "estimatedMinutes": { "type": "integer", "minimum": 15 },
          "icon": { "type": "string" },
          "lessons": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "order", "titleFa", "titleEn", "contentMarkdownFa", "keyTakeawaysFa"],
              "properties": {
                "id": { "type": "string" },
                "order": { "type": "integer" },
                "titleFa": { "type": "string" },
                "titleEn": { "type": "string" },
                "contentMarkdownFa": { "type": "string" },
                "keyTakeawaysFa": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "visualizerType": {
                  "type": "string",
                  "enum": ["osi-stack", "packet-flow", "cam-table", "tcp-handshake", "bit-flipper", "cable-wiring", "none"]
                }
              }
            }
          },
          "labs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "titleFa", "scenarioBriefFa", "hintsFa"],
              "properties": {
                "id": { "type": "string" },
                "titleFa": { "type": "string" },
                "scenarioBriefFa": { "type": "string" },
                "hintsFa": { "type": "array", "items": { "type": "string" } }
              }
            }
          },
          "quiz": {
            "type": "object",
            "required": ["id", "passingThreshold", "questions"],
            "properties": {
              "id": { "type": "string" },
              "passingThreshold": { "type": "number", "minimum": 70, "maximum": 100 },
              "questions": {
                "type": "array",
                "minItems": 5,
                "items": {
                  "type": "object",
                  "required": ["id", "questionFa", "optionsFa", "correctIndex", "explanationFa"],
                  "properties": {
                    "id": { "type": "string" },
                    "questionFa": { "type": "string" },
                    "optionsFa": {
                      "type": "array",
                      "minItems": 2,
                      "maxItems": 4,
                      "items": { "type": "string" }
                    },
                    "correctIndex": { "type": "integer", "minimum": 0, "maximum": 3 },
                    "explanationFa": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
